{
  "id": "openai",
  "name": "OpenAI-style API",
  "version": "1.0.0",
  "description": "Any service with an OpenAI-style chat API (OpenAI, OpenRouter, DeepSeek's API, a local server): its address, a credential for its host, and a model.",
  "tags": ["provider", "api"],
  "pp": 1,
  "files": ["api.js"],
  "provider": {
    "protocol": "openai",
    "base_url": "https://api.openai.com/v1",
    "accepts": { "types": ["image/*"], "max": 4 }
  },
  "settings": [
    {
      "key": "base_url",
      "type": "text",
      "label": "Address",
      "default": "https://api.openai.com/v1"
    },
    {
      "key": "credential",
      "type": "text",
      "label": "Credential (its name in Credentials)",
      "default": ""
    },
    {
      "key": "history",
      "type": "number",
      "label": "Earlier messages sent with each one",
      "default": 20,
      "min": 0
    }
  ]
}
