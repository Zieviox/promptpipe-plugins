{
  "id": "qwen-chat",
  "name": "Qwen Chat",
  "version": "3.4.0",
  "description": "The Qwen web chat (chat.qwen.ai) with your own login (guests get \"no permission\"); Thinking and Search options.",
  "tags": ["provider", "web"],
  "pp": 1,
  "files": ["site.js"],
  "content_script": "site.js",
  "provider": {
    "url": "https://chat.qwen.ai/",
    "chat_urls": ["https://chat.qwen.ai/c/*"],
    "accepts": {
      "types": ["image/*", "application/pdf", "text/*", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"],
      "max": 5
    },
    "settle_ms": 2000,
    "selectors": {
      "input": ["textarea.message-input-textarea", "textarea#chat-input"],
      "send": ["button.send-button:not(.disabled)", "#send-message-button"],
      "stop": ["button.stop-button", "#stop-message-button"],
      "upload": ["input#filesUpload", "input[type=file]"],
      "regenerate": ["[aria-label=Regenerate]", ".qwen-chat-package-comp-new-action-control-container-regenerate"],
      "version_prev": [".qwen-chat-ui-packages-siblings > .anticon:first-child"],
      "version_next": [".qwen-chat-ui-packages-siblings > .anticon:last-child"],
      "reply": [
        ".response-message-content.phase-answer",
        ".chat-response-message .custom-qwen-markdown",
        ".chat-response-message .qwen-markdown"
      ],
      "user": [".chat-user-message .user-message-content", ".user-message-content"],
      "thinking": [
        ".qwen-chat-thinking-and-sources-content-thinking-container",
        ".response-message-content.phase-think",
        ".response-message-content.phase-thinking",
        ".chat-response-message .qwen-chat-thinking-status-card-title-text"
      ],
      "chat_links": ["a[href*='/c/']"],
      "model": [".mms-trigger__name"]
    },
    "model_picker": {
      "open": [".mms-trigger"],
      "items": [
        "[class*='mms'] [role=option]",
        "[class*='mms'] [role=menuitem]",
        "[class*='mms-item']"
      ]
    },
    "options": [
      { "name": "Thinking", "selector": "button", "text": "Thinking" },
      { "name": "Search", "selector": "button", "text": "Search" }
    ]
  },
  "settings": [
    {
      "key": "reply_selector",
      "type": "text",
      "label": "Reply selector (tried first)",
      "default": "",
      "description": "A CSS selector for one reply, if replies aren't found."
    }
  ]
}
